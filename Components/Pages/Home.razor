@page "/"
@attribute [Authorize]
@using System.Security.Claims
@using im_bored.Models
@using im_bored.Services
@using Microsoft.AspNetCore.Identity
@using im_bored.Data
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject QuestGeneratorService QuestService

<PageTitle>Home</PageTitle>

@inject ActivityService ActivityService

<div class="d-flex flex-column align-items-center">
    @* Quest Filters *@
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mb-4">

        @* Filter by Type *@
        <select class="form-select w-auto" @bind="selectedType">
            <option value="">All Types</option>
            @foreach (var type in Enum.GetValues<ActivityType>())
            {
                <option value="@type">@type</option>
            }
        </select>

        @* Filter by Participants *@
        <select class="form-select w-auto" @bind="selectedParticipants">
            <option value="">All Participants</option>
            @foreach (var p in Enum.GetValues<ActivityParticipants>())
            {
                <option value="@p">@p</option>
            }
        </select>

        @* Filter by Price *@
        <select class="form-select w-auto" @bind="selectedPrice">
            <option value="">All Prices</option>
            @foreach (var p in Enum.GetValues<ActivityPrice>())
            {
                <option value="@p">@p</option>
            }
        </select>

        @* Filter by Duration *@
        <select class="form-select w-auto" @bind="selectedDuration">
            <option value="">All Durations</option>
            @foreach (var d in Enum.GetValues<ActivityDuration>())
            {
                <option value="@d">@d</option>
            }
        </select>

        @* Filter by "Kid Friendly" *@
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="kidFriendly" @bind="onlyKidFriendly" />
            <label class="form-check-label" for="kidFriendly">Kid Friendly</label>
        </div>

    </div>

    @if (isQuestAccepted)
    {
        @* Quest Accepted Alert *@
        <div class="animated-message alert alert-success text-center mt-3">@alertMessage</div>
    }
    else if (activity == null)
    {
        @* Generate Random Quest Button *@
        <button class="rainbow-btn btn btn-lg text-white fw-bold px-4 py-2 mt-12 margin-top-12rem"
            @onclick="LoadFilteredActivity">
            ✨ Embark on a Quest ✨
        </button>
    }

    else if (activity != null)
    {
        @* Activity Card *@
        <div class="mt-4 mb-4 p-4 border rounded shadow bg-white" style="width: 90%; max-width: 800px;">
            <h4 class="text-lg font-semibold text-center" style="color: @randomColor">@activity.Title</h4>
            <p><strong>Type:</strong> @activity.Type</p>
            <p><strong>Participants:</strong> @activity.Participants</p>
            <p><strong>Price:</strong> @activity.Price</p>
            <p><strong>Duration:</strong> @activity.ActivityDuration</p>
            <p><strong>Kid Friendly:</strong> @(activity.kidFriendly ? "Yes" : "No")</p>

            <div class="d-flex justify-content-end mt-3 gap-3">
                @* Activity Card Buttons *@
                @if (questDescriptionLoading)
                {
                    <button class="btn btn-primary" disabled>Thinking... please wait</button>
                }
                else
                {

                    <button class="btn btn-dark" @onclick="LoadFilteredActivity">🎲 Reroll Quest</button>
                    <button class="btn rainbow-btn text-white" @onclick="GenerateQuestDescription">
                        🔮 Summon Quest Description
                    </button>
                }

            </div>
        </div>

        @* Quest Description Modal *@
        <div class="modal fade @((showQuestModal ? "show d-block" : ""))" tabindex="-1"
            style="@((showQuestModal ? "background-color: rgba(0,0,0,0.5);" : ""))"
            aria-hidden="@(showQuestModal ? "false" : "true")">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@activity.Title</h5>
                        <button type="button" class="btn-close" @onclick="DeclineQuest"></button>
                    </div>
                    <div class="modal-body" style="white-space: pre-wrap; max-height: 60vh; overflow-y: auto;">
                        @generatedQuestDescription
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-success" @onclick="AcceptQuest">✅ Accept</button>
                        <button class="btn btn-danger" @onclick="DeclineQuest">❌ Decline</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (hasSearched)
    {
        <div class="alert alert-warning mt-3">No quests found with these filters 😢</div>
    }


</div>



@code {
    // Constants
    private const int ALERT_MESSAGE_DISPLAY_DURATION_IN_MILLISECONDS = 5000;

    // Authentication
    private ApplicationUser? currentUser;

    // Activity title color
    private string randomColor = "black";

    // UI State
    private Activity? activity;
    private bool hasSearched = false;
    private bool questDescriptionLoading = false;
    private string generatedQuestDescription = "";
    private bool showQuestModal = false;
    private string? alertMessage;
    private bool isQuestAccepted = false;

    // Filters
    private ActivityType? selectedType = null;
    private ActivityParticipants? selectedParticipants = null;
    private ActivityPrice? selectedPrice = null;
    private ActivityDuration? selectedDuration = null;
    private bool onlyKidFriendly = false;

    /// <summary>
    /// Retrieves the current user on page initialization.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal claimsPrincipal = authState.User;
        currentUser = await UserManager.GetUserAsync(claimsPrincipal);
    }

    /// <summary>
    /// Randomly selects an activity for the user to complete based on search filters.
    /// </summary>
    /// <returns></returns>
    private async Task LoadFilteredActivity()
    {
        randomColor = GetRandomActivityTitleColor();
        activity = await ActivityService.GetFilteredRandomActivity(
        currentUser!,
        selectedType,
        selectedParticipants,
        selectedPrice,
        selectedDuration,
        onlyKidFriendly ? true : null
        );
        hasSearched = true;
    }

    /// <summary>
    /// Randomly selects a color for the activity title.
    /// </summary>
    /// <returns>The name of the randomly selected colour.</returns>
    private string GetRandomActivityTitleColor()
    {
        Random rand = new Random();
        string[] colors = { "red", "green", "blue", "lightblue", "purple", "orange", "pink", "brown", "gray" };
        return colors[rand.Next(colors.Length)];
    }

    /// <summary>
    /// Generates a curated description for the current activity using the user's postal code and AI.
    /// </summary>
    /// <returns></returns> 
    private async Task GenerateQuestDescription()
    {
        if (activity == null) return;
        questDescriptionLoading = true;
        generatedQuestDescription = await QuestService.GenerateQuestDescriptionAsync(activity, currentUser!);
        questDescriptionLoading = false;
        showQuestModal = true;
    }

    /// <summary>
    /// Declines the quest and replaces the current activity with a new one.
    /// </summary> 
    private async void DeclineQuest()
    {
        showQuestModal = false;
        generatedQuestDescription = "";
        await LoadFilteredActivity();

    }

    /// <summary>
    /// Updates the quest accepted message and signals the UI to display it for a short moment.
    /// </summary>
    /// <param name="message">The message to be shown to the user after accepting a quest.</param>
    /// <returns></returns>
    private async Task ShowAlert(string message)
    {
        alertMessage = message;
        isQuestAccepted = true;
        StateHasChanged();
        await Task.Delay(ALERT_MESSAGE_DISPLAY_DURATION_IN_MILLISECONDS);
        isQuestAccepted = false;
        StateHasChanged();
    }

    /// <summary>
    /// Handles accepting a quest by saving the quest and updating the UI. 
    /// </summary>
    /// <returns></returns>
    private async Task AcceptQuest()
    {
        if (activity == null) return;

        await ActivityService.SaveActivityAsync(currentUser!, activity, generatedQuestDescription);
        await ShowAlert($"✅ You accepted \"{activity.Title}\"! Check your Quest Log to view your progress.");

        showQuestModal = false;
        activity = null;
        generatedQuestDescription = "";
        hasSearched = false;
    }
}
