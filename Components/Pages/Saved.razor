@page "/saved"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using im_bored.Components.Layout
@using im_bored.Data
@using im_bored.Models
@using im_bored.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthProvider
@inject ActivityService ActivityService
@inject UserManager<ApplicationUser> UserManager

@inherits LayoutComponentBase

<PageTitle>Quest Log</PageTitle>

<h2 class="text-center mt-4">📖 Quest Log</h2>
@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="animated-message alert alert-success text-center mt-3">@alertMessage</div>
}
else if (savedActivities == null)
{
    @* Loading saved activities spinner *@
    <div class="text-center mt-4">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!savedActivities.Any(a => !a.IsComplete))
{
    @* Message displayed if there are no user-saved activities *@
    <div class="alert alert-info mt-3 text-center">You have not accepted any quests yet.</div>
}
else
{
    @* Displays all user-saved activities in an accordion container *@
    <div class="accordion mt-4 w-100" id="savedActivitiesAccordion" style="max-width: 800px; margin: auto;">
        @foreach (var userSavedActivity in savedActivities.Where(a => !a.IsComplete))
        {
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@userSavedActivity.Activity.Id">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapse-@userSavedActivity.Activity.Id" aria-expanded="false"
                        aria-controls="collapse-@userSavedActivity.Activity.Id">
                        @userSavedActivity.Activity.Title
                    </button>
                </h2>
                <div id="collapse-@userSavedActivity.Activity.Id" class="accordion-collapse collapse"
                    aria-labelledby="heading-@userSavedActivity.Activity.Id" data-bs-parent="#savedActivitiesAccordion">
                    <div class="accordion-body bg-white shadow-sm rounded">
                        <p><strong>Type:</strong> @userSavedActivity.Activity.Type</p>
                        <p><strong>Participants:</strong> @userSavedActivity.Activity.Participants</p>
                        <p><strong>Price:</strong> @userSavedActivity.Activity.Price</p>
                        <p><strong>Duration:</strong> @userSavedActivity.Activity.ActivityDuration</p>
                        <p><strong>Kid Friendly:</strong> @(userSavedActivity.Activity.kidFriendly ? "Yes" : "No")</p>
                        <p><strong>Description:</strong> <div style="white-space: pre-wrap;">@userSavedActivity.Description</div></p>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-success" @onclick="() => CompleteActivityAsync(userSavedActivity)">
                                ✅ Complete
                            </button>

                            <button class="btn btn-danger" @onclick="() => RemoveActivityAsync(userSavedActivity)">
                                ❌ Remove
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}


@code {
    // Constants
    private const int ALERT_MESSAGE_DISPLAY_DURATION_IN_MILLISECONDS = 5000;

    // UI State
    private List<UserSavedActivity>? savedActivities;
    private string? alertMessage;

    // Authentication
    private ClaimsPrincipal? currentUser;

    /// <summary>
    /// Retrieves the current user and their saved activities on page initialization.
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;
        savedActivities = await ActivityService.GetSavedActivitiesAsync(currentUser);
    }

    /// <summary>
    /// Updates the alert message and signals the UI to display it for a short moment.
    /// </summary>
    /// <param name="message">The message to be shown to the user after completing or removing a quest.</param>
    /// <returns></returns>
    private async Task ShowAlert(string message)
    {
        alertMessage = message;
        StateHasChanged();
        await Task.Delay(ALERT_MESSAGE_DISPLAY_DURATION_IN_MILLISECONDS);
        alertMessage = null;
        StateHasChanged();
    }

    /// <summary>
    /// Marks the user's saved activity as complete.
    /// </summary>
    /// <param name="userSavedActivity">The activity saved by the user.</param>
    /// <returns></returns>
    private async Task CompleteActivityAsync(UserSavedActivity userSavedActivity)
    {   
        // Persist changes to UserSavedActivity in the database
        await ActivityService.CompleteActivityAsync(currentUser!, userSavedActivity.Activity);

        // Update the local UI state
        userSavedActivity.IsComplete = true;

        await ShowAlert(
            $"🎉 Congratulations! You completed \"{userSavedActivity.Activity.Title}\" " +
            $"and have received {ActivityService.POINTS_GAINED_PER_ACTIVITY} quest points!"
            );
        StateHasChanged();
    }

    /// <summary>
    /// Removes the activity from the user's saved activities.
    /// </summary>
    /// <param name="userSavedActivity">The saved activity to be removed.</param>
    /// <returns></returns>
    private async Task RemoveActivityAsync(UserSavedActivity userSavedActivity)
    {
        // Persist changes to UserSavedActivity in the database
        await ActivityService.RemoveActivityAsync(currentUser!, userSavedActivity.Activity);

        // Update the local UI state
        savedActivities?.Remove(userSavedActivity);

        await ShowAlert($"🗑️ Removed \"{userSavedActivity.Activity.Title}\" from your saved quests.");
        StateHasChanged();
    }
}